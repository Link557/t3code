diff --git a/apps/web/src/components/chat/TimelineMessageEditor.tsx b/apps/web/src/components/chat/TimelineMessageEditor.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0eff822691ddac5b268e55bcf80c55384bab4d4c
--- /dev/null
+++ b/apps/web/src/components/chat/TimelineMessageEditor.tsx
@@ -0,0 +1,166 @@
+import { createContext, use, useLayoutEffect, useRef, useState } from "react";
+import { T, useGT } from "gt-react";
+import type { MessageId } from "@t3tools/contracts";
+import { composerSubmissionIntentForKey } from "../../composer-logic";
+import { useClientSettings } from "../../hooks/useSettings";
+import { useSoftwareKeyboardOpen } from "../../hooks/useSoftwareKeyboardOpen";
+import { Button } from "../ui/button";
+import {
+  AlertDialog,
+  AlertDialogClose,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogPopup,
+  AlertDialogTitle,
+} from "../ui/alert-dialog";
+import type { useTimelineRewind } from "./useTimelineRewind";
+
+type EditControls = NonNullable<ReturnType<typeof useTimelineRewind>["editControls"]>;
+export const TimelineMessageEditContext = createContext<EditControls | null>(null);
+
+export function TimelineMessageEditor({ messageId }: { readonly messageId: MessageId }) {
+  const controls = use(TimelineMessageEditContext);
+  return controls?.edit.message.id === messageId ? (
+    <MessageEditor key={messageId} controls={controls} />
+  ) : null;
+}
+
+function MessageEditor({ controls }: { readonly controls: EditControls }) {
+  const { edit, keybindings, cancel, submit, editorRef } = controls;
+  const gt = useGT();
+  const sendShortcut = useClientSettings((settings) => settings.sendShortcut);
+  const softwareKeyboardOpen = useSoftwareKeyboardOpen();
+  const [prompt, setPrompt] = useState(edit.draft.prompt);
+  const initialFocus = useRef(true);
+  useLayoutEffect(() => {
+    const textarea = editorRef.current;
+    if (edit.stage === "editing" && initialFocus.current && textarea) {
+      initialFocus.current = false;
+      if (edit.error === null || document.activeElement === document.body) {
+        textarea.focus({ preventScroll: true });
+        textarea.setSelectionRange(textarea.value.length, textarea.value.length);
+      }
+    }
+  }, [edit.stage, edit.error, editorRef]);
+
+  const busy = edit.stage === "sending";
+  const canSubmit = !busy && (prompt.trim() !== "" || (edit.message.attachments?.length ?? 0) > 0);
+  return (
+    <form
+      aria-label={gt("Edit message")}
+      aria-busy={busy}
+      className="ml-auto flex w-[80%] min-w-0 flex-col gap-2 rounded-2xl bg-message px-3.5 py-3 text-message-foreground"
+      onSubmit={(event) => {
+        event.preventDefault();
+        if (canSubmit) submit();
+      }}
+    >
+      <textarea
+        ref={editorRef}
+        aria-label={gt("Edit message")}
+        readOnly={busy}
+        value={prompt}
+        rows={1}
+        className="field-sizing-content max-h-[min(50dvh,24rem)] min-h-6 w-full resize-none bg-transparent text-base leading-relaxed outline-none sm:text-sm"
+        onChange={(event) => {
+          edit.draft.prompt = event.currentTarget.value;
+          setPrompt(edit.draft.prompt);
+        }}
+        onKeyDown={(event) => {
+          if (event.nativeEvent.isComposing || event.keyCode === 229) return;
+          if (event.key === "Escape" && !busy) {
+            event.preventDefault();
+            event.stopPropagation();
+            cancel();
+          } else if (event.key === "Enter" && !event.shiftKey) {
+            const intent = composerSubmissionIntentForKey({
+              event,
+              keybindings,
+              context: {},
+              isSoftwareKeyboardOpen: softwareKeyboardOpen,
+              isDraftThread: false,
+              sendShortcut,
+              prompt,
+            });
+            if (intent !== "foreground") return;
+            event.preventDefault();
+            event.stopPropagation();
+            if (canSubmit) submit();
+          }
+        }}
+      />
+      {edit.message.attachments?.length ? (
+        <div className="flex min-w-0 flex-wrap gap-1.5 text-xs text-muted-foreground">
+          {edit.message.attachments.map((attachment) => (
+            <span
+              key={attachment.id}
+              className="max-w-full truncate rounded-md bg-background/50 px-1.5 py-0.5"
+              title={attachment.name}
+            >
+              {attachment.name}
+            </span>
+          ))}
+        </div>
+      ) : null}
+      {edit.error ? (
+        <p role="alert" className="text-sm text-destructive-foreground">
+          {edit.error}
+        </p>
+      ) : null}
+      <div className="flex items-center justify-end gap-1.5">
+        <Button type="button" variant="ghost" size="sm" disabled={busy} onClick={cancel}>
+          <T>Cancel</T>
+        </Button>
+        <Button type="submit" size="sm" disabled={!canSubmit}>
+          {busy ? <T>Sending…</T> : <T>Send</T>}
+        </Button>
+      </div>
+    </form>
+  );
+}
+
+export function TimelineFileChangesDialog({ controls }: { readonly controls: EditControls }) {
+  return (
+    <AlertDialog
+      open={controls.edit.stage === "confirming"}
+      onOpenChange={(open) => {
+        if (!open) controls.dismissConfirmation();
+      }}
+    >
+      <AlertDialogPopup finalFocus={controls.editorRef}>
+        <AlertDialogHeader>
+          <AlertDialogTitle>
+            <T>How should file changes be handled before resending?</T>
+          </AlertDialogTitle>
+          <AlertDialogDescription>
+            {controls.canRestoreFiles ? (
+              <T>
+                The conversation from this message onward will be replaced. Restoring files also
+                undoes your own changes since this message.
+              </T>
+            ) : (
+              <T>
+                The conversation from this message onward will be replaced. File restoration is
+                unavailable, so resending keeps the current files.
+              </T>
+            )}
+          </AlertDialogDescription>
+        </AlertDialogHeader>
+        <AlertDialogFooter variant="bare">
+          <AlertDialogClose render={<Button variant="ghost" />}>
+            <T>Cancel</T>
+          </AlertDialogClose>
+          {controls.canRestoreFiles ? (
+            <Button variant="ghost-destructive" onClick={() => controls.confirm(true)}>
+              <T>Restore files and send</T>
+            </Button>
+          ) : null}
+          <Button onClick={() => controls.confirm(false)}>
+            <T>Keep files and send</T>
+          </Button>
+        </AlertDialogFooter>
+      </AlertDialogPopup>
+    </AlertDialog>
+  );
+}
