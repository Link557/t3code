index 0000000000000000000000000000000000000000..3215775be1fd7c84a5a3b5a1db5aa829ab7e1ccf
--- /dev/null
+++ b/apps/web/src/components/chat/timelineMessageEdit.logic.ts
@@ -0,0 +1,80 @@
+import type { ThreadStructure } from "@t3tools/client-runtime/state/shell";
+import { checkpointFileTotals } from "@t3tools/client-runtime/state/thread-checkpoints";
+import type { OrchestrationV2TurnItem } from "@t3tools/contracts";
+import {
+  collectComposerContextReferences,
+  replaceComposerContextReferences,
+  restoreAttachmentOnlyBootstrapPrompt,
+  stripAttachmentOnlyBootstrapPrompt,
+} from "@t3tools/shared/composerContextReferences";
+import type { ChatMessage } from "../../types";
+
+export function rewriteSuffixChangesFiles(
+  runs: ThreadStructure["runs"],
+  checkpoints: ThreadStructure["checkpoints"],
+  turnItems: ReadonlyArray<OrchestrationV2TurnItem>,
+  turnCount: number,
+): boolean {
+  const runStatuses = new Map(runs.map((run) => [run.id, run.status]));
+  const suffix = new Set(
+    runs
+      .filter((run) => run.ordinal > turnCount && run.status !== "rolled_back")
+      .map((run) => run.id),
+  );
+  return (
+    checkpoints.some(
+      (checkpoint) =>
+        checkpoint.runId !== null &&
+        (checkpoint.appRunOrdinal ?? 0) > turnCount &&
+        checkpoint.status !== "stale" &&
+        checkpointFileTotals(checkpoint).count > 0 &&
+        // A checkpoint may have outlived a run that paged out of the window.
+        runStatuses.get(checkpoint.runId) !== "rolled_back",
+    ) ||
+    turnItems.some(
+      (item) =>
+        item.runId !== null &&
+        suffix.has(item.runId) &&
+        item.type === "file_change" &&
+        item.status === "completed" &&
+        item.fileName !== "",
+    )
+  );
+}
+
+/** Keep wire references intact while showing their readable labels in the textarea. */
+export function editableTimelinePrompt(message: ChatMessage) {
+  const original = stripAttachmentOnlyBootstrapPrompt(message.text);
+  const references = new Map<string, string>();
+  const literalText = replaceComposerContextReferences(original, () => "");
+  const originalReferences = collectComposerContextReferences(original);
+  const aliases = new Map<string, string>();
+  const prompt = replaceComposerContextReferences(original, ({ label, source }) => {
+    const existing = aliases.get(source);
+    if (existing !== undefined) return existing;
+    let alias = `[${label}]`;
+    let suffix = 2;
+    while (
+      references.has(alias) ||
+      literalText.includes(alias) ||
+      originalReferences.some(
+        (reference) => reference.source !== source && reference.source.startsWith(alias),
+      )
+    ) {
+      alias = `[${label} ${suffix++}]`;
+    }
+    aliases.set(source, alias);
+    references.set(alias, source);
+    return alias;
+  });
+  return { prompt, references };
+}
+
+export function timelineResendText(
+  prompt: string,
+  references: ReadonlyMap<string, string>,
+  hasAttachments: boolean,
+): string {
+  const text = prompt.replace(/\[[^\]\r\n]*\]/g, (label) => references.get(label) ?? label);
+  return restoreAttachmentOnlyBootstrapPrompt(text, hasAttachments);
+}
