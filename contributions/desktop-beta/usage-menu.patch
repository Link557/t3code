+}
+
+// The tick sits in a transparent gap cut from the bar, clamped so it stays inside at 0% and 100%.
+// The gap is a clip-path slot rather than a mask: a mask composites its layer and re-antialiases
+// the bar's rounded ends, and the polygon reaches 1px past the box so only the slot edges clip.
+function paceMarkStyles(timeLeft: number | null) {
+  if (timeLeft === null) return null;
+  const at = `clamp(3px, ${timeLeft}%, calc(100% - 3px))`;
+  const [left, right] = [`calc(${at} - 3px)`, `calc(${at} + 3px)`];
+  const [near, far] = ["-1px", "calc(100% + 1px)"];
+  return {
+    tick: { left: at },
+    gap: {
+      clipPath: `polygon(${near} ${near}, ${left} ${near}, ${left} ${far}, ${right} ${far}, ${right} ${near}, ${far} ${near}, ${far} ${far}, ${near} ${far})`,
+    },
+    // For a track painted on an element that also draws focus rings, which a clip would cut.
+    gappedTrack: {
+      backgroundColor: "transparent",
+      backgroundImage: `linear-gradient(to right, var(--color-muted) ${left}, transparent ${left}, transparent ${right}, var(--color-muted) ${right})`,
+    },
+  };
+}
+
+/**
+ * Pace mark styles for the bar given the returned ref. Below 6px there is no room for the gap
+ * and tick, so the bar draws neither, as the mobile bars do.
+ */
+export function usePaceMark(timeLeft: number | null) {
+  const [bar, setBar] = useState<HTMLElement | null>(null);
+  const [roomy, setRoomy] = useState(false);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- measures the bar DOM width before paint and remeasures through a ResizeObserver
+  useLayoutEffect(() => {
+    if (!bar) return;
+    const measure = () => setRoomy(bar.getBoundingClientRect().width >= 6);
+    measure();
+    return observeResize(bar, measure);
+  }, [bar]);
+  return [setBar, roomy ? paceMarkStyles(timeLeft) : null] as const;
+}
+
+export function quotaSegmentColor(color: string, accentColor: string | undefined): string {
+  return normalizeProviderAccentColor(accentColor) ?? color;
+}
+
+export function UsageQuotaProviderHeading(props: {
+  readonly driver: ServerProvider["driver"];
+  readonly label: string;
+}) {
+  return (
+    <h2 className="flex items-center gap-2 text-sm font-medium text-foreground">
+      <ProviderInstanceIcon
+        driverKind={props.driver}
+        displayName={props.label}
+        indicatorBackground="var(--background)"
+        className="size-5"
+        iconClassName="size-4 text-foreground/80"
+      />
+      {props.label}
+    </h2>
+  );
+}
+
+export function UsageQuotaBarPaint({
+  remaining,
+  refill,
+  color,
+  paceMark,
+}: {
+  readonly remaining: number;
+  readonly refill: number;
+  readonly color: string;
+  readonly paceMark: ReturnType<typeof paceMarkStyles>;
+}) {
+  return (
+    <>
+      <div aria-hidden className="absolute inset-0 overflow-hidden rounded-md">
+        <div className="absolute inset-0" style={paceMark?.gap}>
+          <div
+            data-quota-fill
+            className="absolute inset-y-0 left-0 rounded-md opacity-35"
+            style={{ width: `${remaining}%`, backgroundColor: color }}
+          />
+          {remaining < 100 && refill > 0 ? (
+            <div
+              data-quota-refill
+              className="absolute inset-y-0 right-0 opacity-20"
+              style={{
+                width: `${Math.min(100 - remaining, refill)}%`,
+                backgroundImage: `repeating-linear-gradient(135deg, ${color} 0 1px, transparent 1px 5px)`,
+              }}
+            />
+          ) : null}
+        </div>
+      </div>
+      {paceMark ? (
+        <span
+          aria-hidden
+          data-quota-pace
+          className="absolute inset-y-0.5 w-0.5 -translate-x-1/2 rounded-full bg-foreground"
+          style={paceMark.tick}
+        />
+      ) : null}
+    </>
+  );
+}
diff --git a/apps/web/src/components/usage/usageLimitState.ts b/apps/web/src/components/usage/usageLimitState.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b15e5a7ec840eebac686edea6c676bad37ad8410
--- /dev/null
+++ b/apps/web/src/components/usage/usageLimitState.ts
@@ -0,0 +1,99 @@
+import { useEffect, useMemo } from "react";
+import { makeWindow } from "@t3tools/shared/usageFormat";
+import { useAtomValue } from "@effect/atom-react";
+import type { EnvironmentId, ServerProvider, UsageProviderKind } from "@t3tools/contracts";
+import { refreshUsageLimits } from "@t3tools/client-runtime/state/usage";
+import { create } from "zustand";
+
+import { environmentPresentations } from "../../state/presentation";
+import { serverEnvironment } from "../../state/server";
+import { useAtomCommand } from "../../state/use-atom-command";
+import { PROVIDER_PRESENTATION } from "./usageProviders";
+
+export const useUsageEnvironmentFilter = create<{
+  selectedEnvironmentIds: ReadonlySet<EnvironmentId> | null;
+  setSelectedEnvironmentIds: (ids: ReadonlySet<EnvironmentId> | null) => void;
+}>((set) => ({
+  selectedEnvironmentIds: null,
+  setSelectedEnvironmentIds: (selectedEnvironmentIds) => set({ selectedEnvironmentIds }),
+}));
+
+export function useRefreshFilteredLimits(
+  selectedEnvironmentIds: ReadonlySet<EnvironmentId> | null,
+) {
+  const presentations = useAtomValue(environmentPresentations.presentationsAtom);
+  const refreshProviders = useAtomCommand(serverEnvironment.refreshProviders, {
+    reportFailure: false,
+  });
+  return (automatic: boolean) =>
+    Promise.all(
+      Array.from(presentations, ([environmentId, presentation]) => {
+        if (selectedEnvironmentIds !== null && !selectedEnvironmentIds.has(environmentId)) return;
+        if (presentation.connection.phase === "connected" && presentation.serverConfig !== null) {
+          return refreshUsageLimits(
+            environmentId,
+            () => refreshProviders({ environmentId, input: {} }),
+            automatic,
+          );
+        }
+      }),
+    );
+}
+
+export function useFilteredLimitPresentations(
+  selectedEnvironmentIds: ReadonlySet<EnvironmentId> | null,
+  hiddenProviders: ReadonlySet<UsageProviderKind>,
+) {
+  const presentations = useAtomValue(environmentPresentations.presentationsWithProvidersAtom);
+  const hiddenDrivers = new Set<ServerProvider["driver"]>(
+    [...hiddenProviders].map((provider) => PROVIDER_PRESENTATION[provider].driverKind),
+  );
+  const isVisible = (driver: ServerProvider["driver"]) => !hiddenDrivers.has(driver);
+  return new Map(
+    [...presentations].flatMap(([id, presentation]) => {
+      if (selectedEnvironmentIds !== null && !selectedEnvironmentIds.has(id)) return [];
+      const config = presentation.serverConfig;
+      if (hiddenDrivers.size === 0 || config === null) return [[id, presentation] as const];
+      return [
+        [
+          id,
+          {
+            ...presentation,
+            serverConfig: {
+              ...config,
+              providers: config.providers.filter((provider) => isVisible(provider.driver)),
+              usageLimitSources: config.usageLimitSources?.flatMap((source) => {
+                const accounts = source.accounts.filter((account) => isVisible(account.driver));
+                return accounts.length === 0 && source.accounts.length > 0
+                  ? []
+                  : [{ ...source, accounts }];
+              }),
+            },
+          },
+        ] as const,
+      ];
+    }),
+  );
+}
+
+// Both surfaces use the same time boundaries, including the minute at the end of a 24h window.
+const useUsageWindowStore = create<{ days: number; window: ReturnType<typeof makeWindow> } | null>(
+  () => null,
+);
+export function useUsageWindow(days: number) {
+  const shared = useUsageWindowStore();
+  const initial = useMemo(() => makeWindow(days, undefined, days === 1 ? "hour" : "day"), [days]);
+  const update = (next: ReturnType<typeof makeWindow>) => {
+    const previous = useUsageWindowStore.getState();
+    if (previous?.days !== days || JSON.stringify(previous.window) !== JSON.stringify(next))
+      useUsageWindowStore.setState({ days, window: next }, true);
+    return next;
+  };
+  useEffect(() => {
+    update(initial);
+  }, [initial]);
+  return {
+    window: shared?.days === days ? shared.window : initial,
+    renew: () => update(makeWindow(days, undefined, days === 1 ? "hour" : "day")),
+  };
+}
