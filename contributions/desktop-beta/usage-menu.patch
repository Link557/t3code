diff --git a/apps/web/src/components/usage/DesktopUsageMenu.browser.test.tsx b/apps/web/src/components/usage/DesktopUsageMenu.browser.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9f588a8f4d89dfff90912fdb303923bafcfe6c3f
--- /dev/null
+++ b/apps/web/src/components/usage/DesktopUsageMenu.browser.test.tsx
@@ -0,0 +1,186 @@
+import { EnvironmentId, DEFAULT_CLIENT_SETTINGS } from "@t3tools/contracts";
+import { useSyncExternalStore } from "react";
+import { expect, it, vi } from "vite-plus/test";
+
+import { act, render } from "../../../test/render";
+import { CODEX_PROVIDER } from "../../../test/fakeEnvironment";
+import { __setClientSettingsForTests, getClientSettings } from "../../hooks/useSettings";
+import { getRouter } from "../../router";
+import { createMemoryHistory } from "@tanstack/react-router";
+import { DesktopUsageMenu } from "./DesktopUsageMenu";
+import type { DesktopUsageMenuAction, DesktopUsageMenuSnapshot } from "@t3tools/contracts";
+import { formatTokens, formatUsd, makeWindow } from "@t3tools/shared/usageFormat";
+import * as usageData from "../../state/usage";
+import * as state from "./usageLimitState";
+
+vi.mock("./usageLimitState", { spy: true });
+
+it("keeps cached limits marked offline until the selected machine reconnects", async () => {
+  using cleanup = new DisposableStack();
+  const previousSettings = getClientSettings();
+  cleanup.defer(() => __setClientSettingsForTests(previousSettings));
+  __setClientSettingsForTests({ ...DEFAULT_CLIENT_SETTINGS, showMenuBarUsageLimits: true });
+  const receiveSnapshot = vi.fn();
+  vi.stubGlobal("desktopBridge", {
+    getClientPlatform: () => "darwin",
+    updateUsageMenu: receiveSnapshot,
+  });
+  cleanup.defer(() => vi.unstubAllGlobals());
+
+  const id = EnvironmentId.make("windows-fixture");
+  const checkedAt = "2026-11-22T10:00:00.000Z";
+  const fixture = (phase: "connected" | "disconnected") =>
+    new Map([
+      [
+        id,
+        {
+          connection: { phase },
+          entry: { target: { label: "Sample Windows machine" } },
+          serverConfig: {
+            providers: [
+              {
+                ...CODEX_PROVIDER,
+                usageLimits: {
+                  checkedAt,
+                  windows: [{ id: "session", label: "Session", kind: "session", usedPercent: 28 }],
+                },
+              },
+            ],
+          },
+        },
+      ],
+    ]) as unknown as ReturnType<typeof state.useFilteredLimitPresentations>;
+  let presentations = fixture("disconnected");
+  const updates = new EventTarget();
+  function usePresentations() {
+    return useSyncExternalStore(
+      (notify) => {
+        updates.addEventListener("change", notify);
+        return () => updates.removeEventListener("change", notify);
+      },
+      () => presentations,
+    );
+  }
+  vi.mocked(state.useFilteredLimitPresentations).mockImplementation(usePresentations);
+  const refresh = vi.fn().mockResolvedValue([]);
+  vi.mocked(state.useRefreshFilteredLimits).mockReturnValue(refresh);
+  cleanup.defer(() => {
+    vi.mocked(state.useFilteredLimitPresentations).mockRestore();
+    vi.mocked(state.useRefreshFilteredLimits).mockRestore();
+  });
+
+  const router = getRouter(createMemoryHistory());
+  await using _screen = await render(<DesktopUsageMenu router={router} />);
+  await vi.waitFor(() =>
+    expect(receiveSnapshot.mock.lastCall?.[0]?.sections[0]?.rows[0]).toMatchObject({
+      label: "Session",
+      remaining: 72,
+      stale: "Last known",
+    }),
+  );
+  expect(refresh).not.toHaveBeenCalled();
+
+  await act(() => {
+    presentations = fixture("connected");
+    updates.dispatchEvent(new Event("change"));
+  });
+  await vi.waitFor(() =>
+    expect(receiveSnapshot.mock.lastCall?.[0]?.sections[0]?.rows[0]).toMatchObject({
+      label: "Session",
+      remaining: 72,
+      stale: null,
+    }),
+  );
+  expect(refresh).toHaveBeenCalledWith(true);
+});
+
+vi.mock("../../state/usage", { spy: true });
+
+it("opens on limits, shares the selected usage window and filters, and refreshes the visible metric", async () => {
+  using cleanup = new DisposableStack();
+  const previous = getClientSettings();
+  __setClientSettingsForTests({ ...previous, showMenuBarUsageLimits: true });
+  cleanup.defer(() => __setClientSettingsForTests(previous));
+  let snapshot: DesktopUsageMenuSnapshot | null = null;
+  let send = (_action: DesktopUsageMenuAction) => {};
+  vi.stubGlobal("desktopBridge", {
+    getClientPlatform: () => "darwin",
+    updateUsageMenu: (next: DesktopUsageMenuSnapshot | null) => {
+      snapshot = next;
+    },
+    onUsageMenuAction: (listener: typeof send) => {
+      send = listener;
+      return () => {};
+    },
+  });
+  cleanup.defer(() => vi.unstubAllGlobals());
+  const refresh = vi.fn().mockResolvedValue(undefined);
+  const usage = vi.mocked(usageData.useUsage).mockReturnValue({
+    selectedEnvironments: [{ summary: {} }, { summary: null }],
+    merged: {
+      costUsd: 5,
+      totalTokens: 1200,
+      costQuality: { unpricedShare: 0.2 },
+      daily: [
+        {
+          day: makeWindow(1).untilDay,
+          byProvider: new Map([
+            ["codex", { costUsd: 3, totalTokens: 200 }],
+            ["cursor", { costUsd: 2, totalTokens: 1000 }],
+          ]),
+        },
+      ],
+      hourly: [],
+      providers: [
+        { provider: "codex", costUsd: 3, totalTokens: 200 },
+        { provider: "cursor", costUsd: 2, totalTokens: 1000 },
+      ],
+    },
+    refresh,
+  } as unknown as usageData.UsageView);
+  cleanup.defer(() => usage.mockRestore());
+  const ids = new Set([EnvironmentId.make("windows")]);
+  const oldIds = state.useUsageEnvironmentFilter.getState().selectedEnvironmentIds;
+  state.useUsageEnvironmentFilter.getState().setSelectedEnvironmentIds(ids);
+  cleanup.defer(() => state.useUsageEnvironmentFilter.getState().setSelectedEnvironmentIds(oldIds));
+  const router = getRouter(createMemoryHistory());
+  await using _app = await render(<DesktopUsageMenu router={router} />);
+  const read = (): DesktopUsageMenuSnapshot => snapshot!;
+  expect(read().navigation?.metric).toBe("limits");
+  expect(usage).not.toHaveBeenCalled();
+  await act(() => {
+    send("show");
+    send("cost");
+  });
+  expect(read().summary?.total).toBe(formatUsd(5, "en"));
+  expect(read().summary?.status).toBeNull();
+  expect(read().summary?.trend?.paths).toHaveLength(2);
+  expect(read().summary?.rows.map((row) => row.label)).toEqual(["Codex", "Cursor"]);
+  const costTrend = read().summary!.trend!;
+  expect(costTrend.title).toBe("Daily cost");
+  const period = usage.mock.lastCall?.[0];
+  await act(() => send("tokens"));
+  expect(usage.mock.lastCall?.slice(0, 2)).toEqual([period, ids]);
+  expect(read().summary?.trend?.title).toBe("Daily processed tokens");
+  expect(read().summary?.trend?.paths).not.toEqual(costTrend.paths);
+  expect(read().summary?.total).toBe(formatTokens(1200));
+  expect(read().summary?.rows.map((row) => row.label)).toEqual(["Cursor", "Codex"]);
+  await act(() => send("refresh"));
+  expect(refresh).toHaveBeenCalledTimes(1);
+  await act(() => send("hide"));
+  await act(() => send("show"));
