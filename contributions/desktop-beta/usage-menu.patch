+import { Toggle, ToggleGroup } from "../ui/toggle-group";
+import type { DesktopUsageMenuSnapshot, DesktopUsageQuotaSegment } from "@t3tools/contracts";
+import { ArrowUpRightIcon, RotateCwIcon } from "lucide-react";
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+
+import { UsageQuotaBarPaint, UsageQuotaProviderHeading, usePaceMark } from "./UsageQuotaBar";
+
+function QuotaSegment({ segment }: { readonly segment: DesktopUsageQuotaSegment }) {
+  const [ref, mark] = usePaceMark(segment.timeLeft);
+  return (
+    <div
+      ref={ref}
+      role="img"
+      aria-label={segment.label}
+      title={segment.label}
+      className="relative h-2.5 min-w-0 rounded-md bg-muted"
+      style={mark?.gappedTrack}
+    >
+      <UsageQuotaBarPaint
+        remaining={segment.remaining}
+        refill={segment.refill}
+        color={segment.color}
+        paceMark={mark}
+      />
+    </div>
+  );
+}
+
+export function UsageQuotaPanel({
+  snapshot,
+  onAction,
+  onResize,
+}: {
+  readonly snapshot: DesktopUsageMenuSnapshot;
+  readonly onAction: (
+    action: Parameters<import("@t3tools/contracts").DesktopUsagePanelBridge["request"]>[0],
+  ) => void;
+  readonly onResize?: ((height: number) => void) | undefined;
+}) {
+  const list = useRef<HTMLDivElement>(null);
+  const header = useRef<HTMLElement>(null);
+  const footer = useRef<HTMLElement>(null);
+  useLayoutEffect(() => {
+    const content = list.current;
+    const actions = footer.current;
+    if (!onResize || !content || !actions) return;
+    const measure = () => {
+      onResize(
+        content.getBoundingClientRect().height +
+          actions.getBoundingClientRect().height +
+          (header.current?.getBoundingClientRect().height ?? 0) +
+          2,
+      );
+    };
+    const observer = new ResizeObserver(measure);
+    observer.observe(content);
+    observer.observe(actions);
+    if (header.current) observer.observe(header.current);
+    measure();
+    return () => observer.disconnect();
+  }, [onResize]);
+
+  const buttonClass =
+    "inline-flex min-h-8 items-center gap-1.5 rounded-md px-2.5 text-xs font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-55";
+  return (
+    <main
+      aria-label={snapshot.title}
+      className="flex h-full min-h-0 flex-col overflow-hidden bg-background text-foreground"
+    >
+      <header ref={header} className="flex shrink-0 justify-end px-4 pt-3">
+        {snapshot.navigation && (
+          <ToggleGroup
+            variant="segmented"
+            aria-label={snapshot.title}
+            value={[snapshot.navigation.metric]}
+            onValueChange={(next) => {
+              const metric = snapshot.navigation?.options.find(
+                (option) => option.value === next[0],
+              );
+              if (metric) onAction(metric.value);
+            }}
+          >
+            {snapshot.navigation.options.map(({ value, label }) => (
+              <Toggle key={value} value={value}>
+                {label}
+              </Toggle>
+            ))}
+          </ToggleGroup>
+        )}
+      </header>
+      <div className="min-h-0 flex-1 overflow-y-auto overscroll-contain outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-border">
+        <div ref={list} className="grid gap-4 px-4 py-3">
+          {snapshot.summary ? (
+            <>
+              <section>
+                <p className="text-xs text-muted-foreground">{snapshot.summary.period}</p>
+                {snapshot.summary.total !== null && (
+                  <p className="mt-1 text-2xl font-semibold tabular-nums">
+                    {snapshot.summary.total}
+                  </p>
+                )}
+                {snapshot.summary.status && (
+                  <p role="status" className="mt-1 text-xs text-muted-foreground">
+                    {snapshot.summary.status}
+                  </p>
+                )}
+              </section>
+              {snapshot.summary.trend && (
+                <figure aria-label={snapshot.summary.trend.title} className="grid gap-1">
+                  <figcaption className="text-xs font-medium">
+                    {snapshot.summary.trend.title}
+                  </figcaption>
+                  <div className="flex gap-1.5">
+                    <div
+                      aria-hidden
+                      className="flex h-24 shrink-0 flex-col justify-between text-right text-[10px] tabular-nums text-muted-foreground"
+                    >
+                      <span>{snapshot.summary.trend.peak}</span>
+                      <span>0</span>
+                    </div>
+                    <div className="min-w-0 flex-1">
+                      <svg
+                        aria-hidden
+                        viewBox="0 0 960 260"
+                        preserveAspectRatio="none"
+                        className="block h-24 w-full"
+                      >
+                        {[8, 134, 259].map((y) => (
+                          <line
+                            key={y}
+                            x1="0"
+                            x2="960"
+                            y1={y}
+                            y2={y}
+                            stroke="var(--border)"
+                            vectorEffect="non-scaling-stroke"
+                          />
+                        ))}
+                        {snapshot.summary.trend.paths.map((path) => (
+                          <path
+                            key={path.color}
+                            d={path.area}
+                            fill={path.color}
+                            fillOpacity={0.12}
+                          />
+                        ))}
+                        {snapshot.summary.trend.paths.map((path) => (
+                          <path
+                            key={path.color}
+                            d={path.line}
+                            fill="none"
+                            stroke={path.color}
+                            strokeWidth="1.6"
+                            vectorEffect="non-scaling-stroke"
+                          />
+                        ))}
+                      </svg>
+                      <div className="flex justify-between text-[10px] text-muted-foreground">
+                        <span>{snapshot.summary.trend.first}</span>
+                        <span>{snapshot.summary.trend.last}</span>
+                      </div>
+                    </div>
+                  </div>
+                </figure>
+              )}
+              {snapshot.summary.rows.map((row) => (
+                <div key={row.driver} className="flex items-center justify-between gap-2">
+                  <UsageQuotaProviderHeading driver={row.driver} label={row.label} />
+                  <span className="text-sm tabular-nums">{row.value}</span>
+                </div>
+              ))}
+            </>
+          ) : snapshot.sections.length === 0 ? (
+            <p className="py-3 text-sm text-muted-foreground">{snapshot.empty}</p>
+          ) : (
+            snapshot.sections.map((section) => (
+              <section key={section.driver} className="grid gap-2">
+                <UsageQuotaProviderHeading driver={section.driver} label={section.title} />
+                <div className="grid gap-3 pl-1">
+                  {section.rows.map((row) => (
+                    <div key={row.id} className="grid gap-1.5" aria-label={row.label}>
+                      <div className="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 text-xs">
+                        <span className="min-w-0 grow basis-24 wrap-anywhere font-medium">
+                          {row.label}
+                        </span>
+                        <span
+                          className="shrink-0 font-semibold whitespace-nowrap tabular-nums"
+                          aria-label={row.remainingLabel}
+                        >
+                          {row.remaining}%
+                        </span>
+                        {row.reset ? (
+                          <span className="whitespace-nowrap text-muted-foreground">
+                            {row.reset}
+                          </span>
+                        ) : null}
+                      </div>
+                      <div
+                        className="grid gap-1"
+                        style={{
+                          gridTemplateColumns: `repeat(${row.segments.length}, minmax(0, 1fr))`,
+                        }}
+                      >
+                        {row.segments.map((segment, index) =>
+                          segment ? (
+                            <QuotaSegment key={index} segment={segment} />
+                          ) : (
+                            <div key={index} />
+                          ),
+                        )}
+                      </div>
+                      {row.stale ? (
+                        <p className="text-xs text-muted-foreground">{row.stale}</p>
+                      ) : null}
+                    </div>
+                  ))}
+                </div>
+              </section>
+            ))
+          )}
+          {snapshot.refreshFailed ? (
+            <p role="status" className="text-xs text-muted-foreground">
+              {snapshot.refreshFailed}
+            </p>
+          ) : null}
+        </div>
+      </div>
+      <footer
+        ref={footer}
+        className="flex flex-wrap items-center justify-between gap-1 border-t border-border px-2 py-1.5"
+      >
+        <button
+          type="button"
+          className={buttonClass}
+          onClick={() => onAction("refresh")}
+          disabled={snapshot.refreshing}
+        >
+          <RotateCwIcon
+            aria-hidden
+            className={snapshot.refreshing ? "size-3 animate-spin" : "size-3"}
+          />
+          {snapshot.refresh}
+        </button>
+        <button type="button" className={buttonClass} onClick={() => onAction("open")}>
+          {snapshot.openUsage}
+          <ArrowUpRightIcon aria-hidden className="size-3" />
+        </button>
+      </footer>
+    </main>
+  );
+}
+
+export function DesktopUsagePanel() {
+  const bridge = window.desktopUsagePanel;
+  const [snapshot, setSnapshot] = useState<DesktopUsageMenuSnapshot | null>(null);
+  useEffect(() => bridge?.onSnapshot(setSnapshot), [bridge]);
+  return snapshot && bridge ? (
+    <UsageQuotaPanel snapshot={snapshot} onResize={bridge.resize} onAction={bridge.request} />
+  ) : null;
+}
