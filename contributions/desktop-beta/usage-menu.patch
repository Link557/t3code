+++ b/apps/desktop/src/usage-panel-preload.ts
@@ -0,0 +1,18 @@
+import type { DesktopUsagePanelBridge } from "@t3tools/contracts";
+import { contextBridge, ipcRenderer } from "electron";
+import {
+  USAGE_PANEL_REQUEST_CHANNEL,
+  USAGE_PANEL_RESIZE_CHANNEL,
+  USAGE_PANEL_SNAPSHOT_CHANNEL,
+} from "./ipc/channels.ts";
+
+contextBridge.exposeInMainWorld("desktopUsagePanel", {
+  onSnapshot: (listener) => {
+    const handle: Parameters<typeof ipcRenderer.on>[1] = (_event, snapshot) => listener(snapshot);
+    ipcRenderer.on(USAGE_PANEL_SNAPSHOT_CHANNEL, handle);
+    ipcRenderer.send(USAGE_PANEL_REQUEST_CHANNEL, "ready");
+    return () => ipcRenderer.removeListener(USAGE_PANEL_SNAPSHOT_CHANNEL, handle);
+  },
+  request: (action) => ipcRenderer.send(USAGE_PANEL_REQUEST_CHANNEL, action),
+  resize: (height) => ipcRenderer.send(USAGE_PANEL_RESIZE_CHANNEL, height),
+} satisfies DesktopUsagePanelBridge);
