+});
diff --git a/apps/web/src/components/usage/DesktopUsageMenu.tsx b/apps/web/src/components/usage/DesktopUsageMenu.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3a78a0043e1893fb57f302c48d7201257d760010
--- /dev/null
+++ b/apps/web/src/components/usage/DesktopUsageMenu.tsx
@@ -0,0 +1,338 @@
+import {
+  collectLimitAccounts,
+  collectLimitPools,
+  displayLimitWindows,
+  paceRemainingPercent,
+  remainingPercent,
+} from "@t3tools/shared/usageLimits";
+import { cursorUsageWindowDetails, formatResetsIn } from "@t3tools/shared/usageLimitsCopy";
+import { useGT, useLocale, useMessages } from "gt-react";
+import { useEffect, useEffectEvent, useMemo, useRef, useState } from "react";
+import type {
+  DesktopUsageMenuAction,
+  DesktopUsageMenuSnapshot,
+  EnvironmentId,
+} from "@t3tools/contracts";
+
+import {
+  enumerateDays,
+  enumerateHourStarts,
+  formatDayShort,
+  formatHourShort,
+  formatTokens,
+  formatUsd,
+} from "@t3tools/shared/usageFormat";
+import { useUsage } from "../../state/usage";
+import type { DailyTotals, HourlyTotals } from "@t3tools/shared/usageMerge";
+import { buildChart } from "./UsageProviderChart";
+import { usePrimarySettings } from "../../hooks/useSettings";
+import { resolveHour12 } from "../../timestampFormat";
+import { METRIC_OPTIONS, WINDOW_OPTIONS, type UsageMetric } from "./usageShortcuts";
+import { PROVIDER_PRESENTATION, providersWithUsage, rankProvidersByMetric } from "./usageProviders";
+import type { AppRouter } from "../../router";
+import { useClientSettings } from "../../hooks/useSettings";
+import { providerClients } from "../settings/providerDriverMeta";
+import {
+  useFilteredLimitPresentations,
+  useRefreshFilteredLimits,
+  useUsageEnvironmentFilter,
+  useUsageWindow,
+} from "./usageLimitState";
+import { barColor, quotaSegmentColor } from "./UsageQuotaBar";
+import { useUsagePagePreferences } from "./usagePagePreferences";
+
+export function DesktopUsageMenu({ router }: { readonly router: AppRouter }) {
+  const enabled = useClientSettings((settings) => settings.showMenuBarUsageLimits);
+  return enabled &&
+    window.desktopBridge?.getClientPlatform() === "darwin" &&
+    window.desktopBridge.updateUsageMenu ? (
+    <EnabledDesktopUsageMenu router={router} />
+  ) : null;
+}
+
+function EnabledDesktopUsageMenu({ router }: { readonly router: AppRouter }) {
+  const bridge = window.desktopBridge;
+  const gt = useGT();
+  const m = useMessages();
+  const [preferences, setPreferences] = useUsagePagePreferences();
+  const { selectedEnvironmentIds } = useUsageEnvironmentFilter();
+  const presentations = useFilteredLimitPresentations(
+    selectedEnvironmentIds,
+    new Set(preferences.hiddenProviders),
+  );
+  const refreshLimits = useRefreshFilteredLimits(selectedEnvironmentIds);
+  const [metric, setMetric] = useState<UsageMetric>("limits");
+  const summaryRefresh = useRef<(() => void) | null>(null);
+  const [now, setNow] = useState(() => Date.now());
+  const [visible, setVisible] = useState(false);
+  const [refreshing, setRefreshing] = useState(false);
+  const [refreshFailed, setRefreshFailed] = useState(false);
+  const connectedIds = [...presentations]
+    .filter(([, value]) => value.connection.phase === "connected")
+    .map(([id]) => id)
+    .sort()
+    .join("\n");
+
+  const refresh = useEffectEvent((automatic: boolean) => {
+    if (!automatic) {
+      setRefreshing(true);
+      setRefreshFailed(false);
+    }
+    void refreshLimits(automatic)
+      .then(
+        (results) => {
+          if (results.some((result) => result !== undefined)) setRefreshFailed(false);
+          setNow(Date.now());
+        },
+        (error: unknown) => {
+          console.error("Could not refresh menu bar usage limits.", error);
+          setRefreshFailed(true);
+        },
+      )
+      .finally(() => {
+        if (!automatic) setRefreshing(false);
+      });
+  });
+
+  const handleAction = useEffectEvent((action: DesktopUsageMenuAction) => {
+    switch (action) {
+      case "cost":
+      case "tokens":
+      case "limits":
+        if (action === "limits" && metric !== "limits") refresh(true);
+        setMetric(action);
+        break;
+      case "open":
+        setPreferences((current) => ({ ...current, metric }));
+        void router.navigate({ to: "/usage" });
+        break;
+      case "show":
+        setVisible(true);
+        setNow(Date.now());
+        if (metric === "limits") refresh(true);
+        break;
+      case "hide":
+        setVisible(false);
+        break;
+      case "refresh":
+        if (metric === "limits") refresh(false);
+        else summaryRefresh.current?.();
+        break;
+    }
+  });
+  useEffect(() => bridge?.onUsageMenuAction?.((action) => handleAction(action)), [bridge]);
+  useEffect(() => () => bridge?.updateUsageMenu?.(null), [bridge]);
+  useEffect(() => {
+    if (connectedIds) refresh(true);
+  }, [connectedIds]);
+  useEffect(() => {
+    if (!visible) return;
+    const tick = window.setInterval(() => setNow(Date.now()), 30_000);
+    return () => window.clearInterval(tick);
+  }, [visible]);
+
+  const base = {
+    navigation: {
+      metric,
+      options: METRIC_OPTIONS.map((option) => ({ value: option.value, label: m(option.label) })),
+    },
+    sections:
+      metric !== "limits"
+        ? []
+        : usageQuotaSections(
+            presentations,
+            now,
+            gt,
+            m,
+            (id) => presentations.get(id)?.connection.phase === "connected",
+          ),
+    title: gt("Usage metric"),
+    empty: gt("No usage limits available"),
+    refresh: gt("Refresh limits"),
+    openUsage: gt("Open Usage…"),
+    refreshing,
+    refreshFailed: refreshFailed ? gt("Could not refresh limits") : null,
+  };
+  const snapshot = JSON.stringify(base);
+  useEffect(() => {
+    if (metric === "limits") bridge?.updateUsageMenu?.(JSON.parse(snapshot));
+  }, [bridge, snapshot, metric]);
+  return visible && metric !== "limits" ? (
+    <UsageSummaryPublisher
+      base={base}
+      metric={metric}
+      preferences={preferences}
+      ids={selectedEnvironmentIds}
+      refreshRef={summaryRefresh}
+    />
+  ) : null;
+}
+
+function UsageSummaryPublisher({
+  base,
+  metric,
+  preferences,
+  ids,
+  refreshRef,
+}: {
+  base: DesktopUsageMenuSnapshot;
+  metric: "tokens" | "cost";
+  preferences: ReturnType<typeof useUsagePagePreferences>[0];
+  ids: ReadonlySet<EnvironmentId> | null;
+  refreshRef: { current: (() => void) | null };
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const locale = useLocale();
+  const days = preferences.windowDays;
+  const { window: windowInput, renew } = useUsageWindow(days);
+  const hidden = useMemo(() => new Set(preferences.hiddenProviders), [preferences.hiddenProviders]);
+  const usage = useUsage(windowInput, ids, hidden);
+  const [busy, setBusy] = useState(false);
+  const [failed, setFailed] = useState(false);
+  const refresh = useEffectEvent(async () => {
+    if (busy) return;
+    setBusy(true);
+    setFailed(false);
+    try {
+      await usage.refresh(renew());
+    } catch {
+      setFailed(true);
+    } finally {
+      setBusy(false);
+    }
+  });
+  useEffect(() => {
+    refreshRef.current = () => void refresh();
+    return () => {
+      refreshRef.current = null;
+    };
+  }, [refreshRef]);
+  const { merged, selectedEnvironments } = usage;
+  const answered = selectedEnvironments.filter((env) => env.summary !== null).length;
+  const format = (value: number) =>
+    metric === "cost" ? formatUsd(value, locale) : formatTokens(value);
+  const hour12 = usePrimarySettings((settings) => resolveHour12(settings.timestampFormat));
+  const hourly = windowInput.resolution === "hour";
+  const periods =
+    hourly && windowInput.sinceTime && windowInput.untilTime
+      ? enumerateHourStarts(windowInput.sinceTime, windowInput.untilTime)
+      : enumerateDays(windowInput.sinceDay, windowInput.untilDay);
+  const entries: readonly (DailyTotals | HourlyTotals)[] = hourly ? merged.hourly : merged.daily;
+  const byPeriod = new Map(
+    entries.map((entry) => ["hourStart" in entry ? entry.hourStart : entry.day, entry] as const),
+  );
+  const providers = providersWithUsage(merged.providers);
+  const chart = buildChart(periods, byPeriod, metric, providers, new Set());
+  const label = (period: string) =>
+    hourly
+      ? formatHourShort(period, windowInput.timeZone, hour12, locale)
+      : formatDayShort(period, locale);
+  const trendTitle = hourly
+    ? metric === "cost"
+      ? gt("Hourly cost")
+      : gt("Hourly processed tokens")
+    : metric === "cost"
+      ? gt("Daily cost")
+      : gt("Daily processed tokens");
+  const period = m(WINDOW_OPTIONS.find((o) => o.days === days)!.label);
+  const snapshot = JSON.stringify({
+    ...base,
+    refresh: gt("Refresh usage"),
+    refreshing: busy,
+    refreshFailed: failed ? gt("Could not refresh usage") : null,
+    summary: {
+      period,
+      ...(answered && periods.length
+        ? {
+            trend: {
+              title: trendTitle,
+              first: label(periods[0]!),
+              last: label(periods[periods.length - 1]!),
+              peak: format(chart.scale.max),
+              paths: chart.paths.map(({ provider, line, area }) => ({
+                line,
+                area,
+                color: PROVIDER_PRESENTATION[provider].color,
+              })),
+            },
+          }
+        : {}),
+      total: answered ? format(metric === "cost" ? merged.costUsd : merged.totalTokens) : null,
+      status: answered ? null : usage.isPending ? gt("Loading…") : gt("No usage data available"),
+      rows: rankProvidersByMetric(
+        providersWithUsage(merged.providers),
+        merged.providers,
+        metric,
+      ).map((provider) => {
+        const totals = merged.providers.find((entry) => entry.provider === provider)!;
+        return {
+          driver: PROVIDER_PRESENTATION[provider].driverKind,
+          label: PROVIDER_PRESENTATION[provider].label,
+          value: format(metric === "cost" ? totals.costUsd : totals.totalTokens),
+        };
+      }),
+    },
+  });
+  useEffect(() => {
+    window.desktopBridge?.updateUsageMenu?.(JSON.parse(snapshot));
+  }, [snapshot]);
+  return null;
+}
+
+type QuotaPresentations = Parameters<typeof collectLimitAccounts>[0];
+
+export function usageQuotaSections(
+  presentations: QuotaPresentations,
+  now: number,
+  gt: ReturnType<typeof useGT>,
+  m: ReturnType<typeof useMessages>,
+  isConnected?: (id: EnvironmentId) => boolean,
+): DesktopUsageMenuSnapshot["sections"] {
+  const pools = collectLimitPools(collectLimitAccounts(presentations), now);
+  const anyConnected = isConnected && [...presentations.keys()].some(isConnected);
+  return pools.flatMap((pool) => {
+    const rows = displayLimitWindows(pool).map((window) => {
+      const details =
+        pool.driver === "cursor" ? cursorUsageWindowDetails(window.id, pool, m) : undefined;
+      const label = details?.label ?? window.label;
+      const nextReset = window.resets[0];
+      let stale = false;
+      const segments = window.columns.map((member, index) => {
+        if (!member.window) return null;
+        const { account } = member;
+        const origins = account.environments.map((origin) => origin.environmentId);
+        if (origins.length === 0 && account.redeem) origins.push(account.redeem.environmentId);
+        if (isConnected && (origins.length > 0 ? !origins.some(isConnected) : !anyConnected))
+          stale = true;
+        const remaining = remainingPercent(member.window);
+        const namedAccount = account.displayName || gt("Account {number}", { number: index + 1 });
+        return {
+          label: gt("{name}: {remaining}% left", { name: namedAccount, remaining }),
+          color: quotaSegmentColor(barColor(pool.driver), account.accentColor),
+          remaining,
+          refill: member.window.resetsAt ? member.refillPercent : 0,
+          timeLeft: paceRemainingPercent(member.window, now),
+        };
+      });
+      return {
+        id: `${window.kind}:${window.id}`,
+        label,
+        remaining: window.remainingPercent,
+        remainingLabel: gt("{percent}% remaining", { percent: window.remainingPercent }),
+        reset: nextReset ? formatResetsIn(nextReset.member.window, now, m, "refill") : null,
+        stale: stale ? gt("Last known") : null,
+        segments,
+      };
+    });
+    return rows.length > 0
+      ? [
+          {
+            driver: pool.driver,
+            title: providerClients.get(pool.driver)?.label ?? pool.driver,
+            rows,
+          },
+        ]
+      : [];
+  });
+}
