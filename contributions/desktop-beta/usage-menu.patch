+import { page, userEvent } from "vite-plus/test/browser";
+
+import { act, render } from "../../../test/render";
+import { CODEX_PROVIDER } from "../../../test/fakeEnvironment";
+import stylesheet from "../../index.css?inline";
+import { usageQuotaSections } from "./DesktopUsageMenu";
+import { UsageQuotaPanel } from "./DesktopUsagePanel";
+import { UsageLimitsPooled } from "./UsageLimitsPooled";
+
+const checkedAt = "2026-11-22T10:00:00.000Z";
+const now = Date.parse(checkedAt);
+const resetsAt = "2026-11-22T13:00:00.000Z";
+
+function provider(
+  driver: string,
+  name: string,
+  windows: NonNullable<ServerProvider["usageLimits"]>["windows"],
+  accentColor?: string,
+): ServerProvider {
+  return {
+    ...CODEX_PROVIDER,
+    status: "ready",
+    auth: { status: "authenticated" },
+    instanceId: ProviderInstanceId.make(name.toLowerCase().replaceAll(" ", "-")),
+    driver: ProviderDriverKind.make(driver),
+    displayName: name,
+    checkedAt,
+    models: [],
+    slashCommands: [],
+    skills: [],
+    usageLimits: { checkedAt, windows },
+    ...(accentColor ? { accentColor } : {}),
+  };
+}
+
+const environment = EnvironmentId.make("fixture");
+const presentations = new Map([
+  [
+    environment,
+    {
+      entry: { target: { label: "Sample Mac" } },
+      serverConfig: {
+        providers: [
+          provider("codex", "Codex", [
+            {
+              id: "week",
+              kind: "weekly",
+              label: "Weekly",
+              usedPercent: 8,
+              resetsAt,
+              windowDurationMins: 10080,
+            },
+          ]),
+          provider("claudeAgent", "Claude", [
+            {
+              id: "session",
+              kind: "session",
+              label: "Session",
+              usedPercent: 26,
+              resetsAt,
+              windowDurationMins: 300,
+            },
+          ]),
+          provider("cursor", "Cursor Personal", [
+            {
+              id: "apiPercentUsed",
+              kind: "monthly",
+              label: "API",
+              usedPercent: 48,
+              resetsAt,
+              windowDurationMins: 43200,
+            },
+          ]),
+          provider(
+            "cursor",
+            "Cursor Studio",
+            [{ id: "apiPercentUsed", kind: "monthly", label: "API", usedPercent: 0 }],
+            "#497de8",
+          ),
+          provider("antigravity", "Antigravity", [
+            {
+              id: "gemini-5h",
+              kind: "session",
+              label: "Gemini · 5-hour",
+              usedPercent: 100,
+              resetsAt,
+              windowDurationMins: 300,
+            },
+            { id: "gemini-weekly", kind: "weekly", label: "Gemini · Weekly", usedPercent: 38 },
+          ]),
+        ],
+      },
+    },
+  ],
+]);
+
+function Comparison({
+  onAction,
+  empty = false,
+}: {
+  readonly onAction: import("@t3tools/contracts").DesktopUsagePanelBridge["request"];
+  readonly empty?: boolean;
+}) {
+  const sections = usageQuotaSections(presentations, now, useGT(), useMessages());
+  return (
+    <div className="flex h-screen items-start gap-8 overflow-auto bg-muted p-7">
+      <section
+        className="min-w-0 flex-1 space-y-4 rounded-xl border border-border bg-background p-5"
+        aria-label="Usage page"
+      >
+        <h1 className="text-lg font-semibold">Usage · Limits</h1>
+        <UsageLimitsPooled presentations={presentations} now={now} />
+      </section>
+      <section
+        className="h-[526px] w-[360px] shrink-0 overflow-hidden rounded-xl border border-border bg-background shadow-sm"
+        aria-label="Menu bar panel"
+      >
+        <UsageQuotaPanel
+          snapshot={{
+            sections: empty ? [] : sections,
+            title: "Usage limits",
+            empty: "No usage limits available",
+            refresh: "Refresh limits",
+            openUsage: "Open Usage…",
+            refreshing: false,
+            refreshFailed: null,
+          }}
+          onAction={onAction}
+        />
+      </section>
+    </div>
+  );
+}
+
+it("shares usage fills, provider and account colors, refill stripes, and pace marks", async () => {
+  await page.viewport(1240, 980);
+  const style = document.createElement("style");
+  style.textContent = stylesheet;
+  document.head.append(style);
+  using cleanup = {
+    [Symbol.dispose]: () => {
+      style.remove();
+      document.documentElement.classList.remove("dark");
+    },
+  };
+  document.documentElement.classList.add("dark");
+  const onAction = vi.fn();
+  await using rendered = await render(<Comparison onAction={onAction} />);
+  const usage = page.getByRole("region", { name: "Usage page" });
+  const panel = page.getByRole("region", { name: "Menu bar panel" });
+  for (const name of ["Codex", "Claude", "Cursor", "Antigravity"]) {
+    await expect.element(panel.getByRole("heading", { name })).toBeVisible();
+  }
+  const visual = (root: Element) =>
+    [...root.querySelectorAll("[data-quota-fill]")].map((el) => {
+      const fill = el as HTMLElement;
+      const bar = fill.parentElement!.parentElement!.parentElement!;
+      const refill = bar.querySelector<HTMLElement>("[data-quota-refill]");
+      return {
+        width: fill.style.width,
+        color: fill.style.backgroundColor,
+        refill: refill?.style.width ?? null,
+        stripes: refill?.style.backgroundImage ?? null,
+        pace: bar.querySelector<HTMLElement>("[data-quota-pace]")?.style.left ?? null,
+      };
+    });
+  const fills = visual(panel.element());
+  expect(fills).toEqual(visual(usage.element()));
+  expect(fills).toHaveLength(6);
+  expect(fills).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({ width: "0%", refill: "100%" }),
+      expect.objectContaining({ width: "100%", refill: null }),
+      expect.objectContaining({ width: "62%", refill: null, pace: null }),
+      expect.objectContaining({ color: "rgb(73, 125, 232)" }),
+    ]),
+  );
+  const refresh = panel.getByRole("button", { name: "Refresh limits" });
+  await expect.element(refresh).toBeVisible();
+  await userEvent.click(refresh);
+  expect(onAction).toHaveBeenCalledWith("refresh");
+  await userEvent.click(panel.getByRole("button", { name: "Open Usage…" }));
+  expect(onAction).toHaveBeenCalledWith("open");
+  await act(() => rendered.rerender(<Comparison onAction={onAction} empty />));
+  await expect.element(panel.getByText("No usage limits available")).toBeVisible();
+});
