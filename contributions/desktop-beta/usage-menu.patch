diff --git a/apps/desktop/src/window/UsageMenuBar.ts b/apps/desktop/src/window/UsageMenuBar.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d02668c028a0d387820ef8328b9dd39cfce5eecc
--- /dev/null
+++ b/apps/desktop/src/window/UsageMenuBar.ts
@@ -0,0 +1,191 @@
+import { app, BrowserWindow, nativeImage, screen, Tray } from "electron";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { DesktopUsageMenuSnapshot, type DesktopUsageMenuAction } from "@t3tools/contracts";
+import {
+  USAGE_MENU_ACTION_CHANNEL,
+  USAGE_MENU_SNAPSHOT_CHANNEL,
+  USAGE_PANEL_REQUEST_CHANNEL,
+  USAGE_PANEL_RESIZE_CHANNEL,
+  USAGE_PANEL_SNAPSHOT_CHANNEL,
+} from "../ipc/channels.ts";
+
+// The flat wordmark from assets/prod/logo.svg, rendered as a template with transparent lettering.
+const ICON =
+  "";
+const WIDTH = 360;
+const MAX_HEIGHT = 560;
+const GAP = 6;
+const decodeSnapshot = Schema.decodeUnknownOption(Schema.NullOr(DesktopUsageMenuSnapshot));
+
+export function installUsageMenuBar(
+  window: BrowserWindow,
+  applicationUrl: string,
+  preload: string,
+  logFailure: (error: unknown) => void,
+) {
+  const contents = window.webContents;
+  let tray: Tray | null = null;
+  let panel: BrowserWindow | null = null;
+  let snapshot: DesktopUsageMenuSnapshot | null = null;
+  let requested = false;
+  let ready = false;
+
+  const send = (action: DesktopUsageMenuAction) => {
+    if (!contents.isDestroyed()) contents.send(USAGE_MENU_ACTION_CHANNEL, action);
+  };
+  const publish = () => {
+    if (ready && panel && !panel.webContents.isDestroyed()) {
+      panel.webContents.send(USAGE_PANEL_SNAPSHOT_CHANNEL, requested ? snapshot : null);
+    }
+  };
+  const hide = () => {
+    if (!requested) return;
+    requested = false;
+    panel?.hide();
+    publish();
+    send("hide");
+  };
+  const reset = () => {
+    hide();
+    panel?.destroy();
+    panel = null;
+    tray?.destroy();
+    tray = null;
+    snapshot = null;
+    ready = false;
+  };
+
+  const makePanel = () => {
+    const usageWindow = new BrowserWindow({
+      width: WIDTH,
+      height: 160,
+      show: false,
+      frame: false,
+      resizable: false,
+      skipTaskbar: true,
+      fullscreenable: false,
+      alwaysOnTop: true,
+      webPreferences: {
+        preload,
+        contextIsolation: true,
+        nodeIntegration: false,
+        sandbox: true,
+        spellcheck: false,
+      },
+    });
+    const web = usageWindow.webContents;
+    const target = new URL("usage-panel.html", applicationUrl).href;
+
+    web.setWindowOpenHandler(() => ({ action: "deny" }));
+    web.on("will-navigate", (event) => event.preventDefault());
+    web.ipc.on(USAGE_PANEL_REQUEST_CHANNEL, (event, action: unknown) => {
+      if (event.senderFrame !== web.mainFrame || event.senderFrame?.url !== target) return;
+      if (action === "ready") {
+        ready = true;
+        publish();
+      } else if (requested && (action === "cost" || action === "tokens" || action === "limits")) {
+        send(action);
+      } else if (requested && action === "refresh") {
+        send("refresh");
+      } else if (requested && action === "open") {
+        hide();
+        if (window.isMinimized()) window.restore();
+        window.show();
+        window.focus();
+        send("open");
+      }
+    });
+    web.ipc.on(USAGE_PANEL_RESIZE_CHANNEL, (event, height: unknown) => {
+      if (
+        event.senderFrame !== web.mainFrame ||
+        event.senderFrame?.url !== target ||
+        !requested ||
+        !tray ||
+        typeof height !== "number" ||
+        !Number.isFinite(height)
+      )
+        return;
+      const anchor = tray.getBounds();
+      const area = screen.getDisplayMatching(anchor).workArea;
+      const y = Math.max(area.y, anchor.y + anchor.height) + GAP;
+      const heightLimit = Math.max(1, Math.min(MAX_HEIGHT, area.y + area.height - y - GAP));
+      const width = Math.min(WIDTH, area.width);
+      const centered = Math.round(anchor.x + (anchor.width - width) / 2);
+      const x = Math.min(Math.max(centered, area.x), area.x + area.width - width);
+      usageWindow.setBounds({
+        x,
+        y,
+        width,
+        height: Math.min(heightLimit, Math.max(1, Math.ceil(height))),
+      });
+      if (!usageWindow.isVisible()) usageWindow.show();
+    });
+    web.on("before-input-event", (event, input) => {
+      if (input.type !== "keyDown" || input.key !== "Escape") return;
+      event.preventDefault();
+      hide();
+    });
+    web.on("render-process-gone", () => usageWindow.destroy());
+    usageWindow.on("blur", () => {
+      if (!tray) return;
+      // A tray click also blurs the window. Let the tray handle that toggle once.
+      const point = screen.getCursorScreenPoint();
+      const anchor = tray.getBounds();
+      if (
+        point.x < anchor.x ||
+        point.x >= anchor.x + anchor.width ||
+        point.y < anchor.y ||
+        point.y >= anchor.y + anchor.height
+      )
+        hide();
+    });
+    usageWindow.on("closed", () => {
+      panel = null;
+      ready = false;
+      hide();
+    });
+    void usageWindow.loadURL(target).catch((error: unknown) => {
+      logFailure(error);
+      if (!usageWindow.isDestroyed()) usageWindow.destroy();
+    });
+    return usageWindow;
+  };
+
+  const toggle = () => {
+    if (!snapshot) return;
+    if (requested) {
+      hide();
+      return;
+    }
+    requested = true;
+    panel ??= makePanel();
+    publish();
+    send("show");
+  };
+
+  contents.ipc.on(USAGE_MENU_SNAPSHOT_CHANNEL, (event, input: unknown) => {
+    if (event.senderFrame !== contents.mainFrame) return;
+    const decoded = decodeSnapshot(input);
+    if (Option.isNone(decoded)) return;
+    snapshot = decoded.value;
+    if (snapshot === null) {
+      reset();
+      return;
+    }
+    if (!tray) {
+      const image = nativeImage.createFromBuffer(Buffer.from(ICON, "base64"), { scaleFactor: 2 });
+      image.setTemplateImage(true);
+      tray = new Tray(image);
+      tray.setToolTip("T3 Code");
+      tray.on("click", toggle);
+    }
+    publish();
+  });
+  contents.on("render-process-gone", reset);
+  app.once("will-quit", reset);
+  window.once("closed", () => {
+    app.removeListener("will-quit", reset);
+    reset();
+  });
+}
